# Application
APP_NAME=PinMe API
APP_ENV=local
DEBUG=true

# Database (matches docker-compose Postgres)
DATABASE_URL=postgresql+psycopg://pinme:pinme@localhost:5433/pinme

# Bootstrap object storage (S3-compatible locally; Cloudflare R2 in cloud later)
# Local default matches adobe/s3mock in docker-compose.yml (port 9090).
# If you run MinIO instead, use http://localhost:9000 and your MinIO keys.
S3_ENDPOINT_URL=http://localhost:9090
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=pin-me
S3_REGION=us-east-1

# Auth
JWT_SECRET=change-me-in-production-use-32chars
JWT_EXPIRE_HOURS=168
AUTH_COOKIE_NAME=pinme_access

# Google OAuth (Cloud Console → OAuth client, redirect URI must match)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
WEB_APP_ORIGIN=http://localhost:3001

# Ensure this email exists in users on API startup (allowlist)
ALLOWLIST_SEED_EMAIL=

# Local-only passwordless login for allowlisted emails (no Google required)
AUTH_DEV_BYPASS=true

# CORS (portfolio :3000, pin-me-web :3001)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
